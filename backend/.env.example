# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Leave blank to use local SQLite during development.
# PostgreSQL example: postgres://USER:PASSWORD@HOST:5432/DB_NAME
DATABASE_URL=

# Frontend integration
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# AI chat provider settings. Put the real API key in backend/.env only.
GEMINI_API_KEY=
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=20
# Voice requests send audio/text to Google Gemini. Keep disabled until this
# third-party processing is explicitly enabled for your deployment.
VOICE_CLOUD_ENABLED=False
GEMINI_STT_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
MAPS_API_KEY=
# Required for public Nominatim city/postcode geocoding. Set an identifying app
# name and contact detail before enabling that search mode.
MAPS_USER_AGENT=
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search

# Emergency contact and call guidance (India ERSS default; override by locale).
EMERGENCY_SERVICES_NUMBER=112
EMERGENCY_SERVICES_LABEL=India emergency services
EMERGENCY_SERVICES_INFO_URL=https://112.gov.in/

# Local report OCR. Install Tesseract separately and include its traineddata
# files for each language code, e.g. eng or eng+hin.
TESSERACT_CMD=tesseract
TESSERACT_LANGUAGES=eng

# Local medical RAG. Index only reviewed documents placed in data/medical/.
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DEVICE=cpu
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_MIN_SIMILARITY_SCORE=0.20

# Logging (JSON to stdout)
LOG_LEVEL=INFO

# Used only by docker-compose for the local Postgres container
POSTGRES_PASSWORD=
